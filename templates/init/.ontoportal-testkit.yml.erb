component_name: <%= component_name %>
app_service: <%= app_service %>
<% unless dockerfile == Ontoportal::Testkit::ComponentConfig::DEFAULT_DOCKERFILE -%>
dockerfile: <%= dockerfile %>
<% end -%>
backends:
  - fs
  - ag
  - vo
  - gd
<% if dependency_services.empty? -%>
dependency_services: []
<% else -%>
dependency_services:
<% dependency_services.each do |service| -%>
  - <%= service %>
<% end -%>
<% end -%>
